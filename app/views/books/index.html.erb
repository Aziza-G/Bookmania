<div class="bg-[#F7F4ED]">
<p style="color: green"><%= notice %></p>

<% content_for :title, "Books" %>

<div class="mb-8 bg-white">
<h1 class="text-4xl font-bold text-[#11296B] mb-3"> Discover Books</h1>

<p class="text-gray-600">Browse, review, and share your favourite books.</p>
</div>

<div id="books" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 p-8">
  <% @books.each do |book| %>
    <%= render book %>
  <% end %>
</div>

<%= link_to "+", new_book_path, class: "fixed z-[999] bottom-6 right-6 w-14 h-14 flex items-center justify-center bg-[#11296B] hover:bg-[#FFD500] text-[#FFFFFF] hover:text-[#11296B] rounded-full shadow-lg transition-all duration-300 hover:scale-110" %>

<%# class = "container mx-auto mt-28 px-5 flex" %>
