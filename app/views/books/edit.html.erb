<% content_for :title, "Editing book" %>
<div class="bg-white py-5">
<h1 class= "text-3xl font-bold text-[#11296B] bg-white">Edit Book</h1>

  <p class="text-gray-600 pt-3">Keep Everything up to date!</p>
</div>

<div class="mt-6">

<%= render "form", book: @book %>

<br>

<div>
  <%= link_to "Show this book", @book, class: "bg-[#F7F4ED] text-[#11296B] px-4 py-2 rounded border border-[#11296B] hover:text-[#d8cab0]" %> |,
  <%= link_to "Back to books", books_path, class: "bg-[#F7F4ED] text-[#11296B] px-4 py-2 rounded border border-[#11296B] hover:text-[#d8cab0]" %>
</div>
