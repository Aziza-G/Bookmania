<p style="color: green"><%= notice %></p>

<%= render @book %>

<p><strong>Pages: <%= @book.page_count %></strong></p>

<% if @book.book_file.attached? %>
    <p class="mb-2"> 📖 Download Book: 
        <%= link_to @book.book_file.filename,
              rails_blob_path(@book.book_file, disposition: "attachment"),
              class: "text-blue-500 underline" %>
    </p>
    <% end %>

  <h2>Reviews</h2>

<% @book.reviews.each do |review| %>
  <div class="mb-4 p-4 border rounded">

    <span>
    <p>
      <strong>Reviewer:</strong>
      <%= review.user&.email_address || "Anonymous User" %>
    </p>
    </span>

    <span>
      <p class= "text-sm text-gray-500">
        Reviewed: <%= time_ago_in_words(review.created_at) %> ago
      </p>
    </span>

    <p>
      <strong>Rating:</strong>

      <span style="color: gold; font-size: 24px;">
        <% rating = review.rating.to_i %>
        <%= "★" * rating %>
        <%= "☆" * (5 - rating) %>
      </span>

      (<%= review.rating %>/5)
    </p>

    <p><%= review.content %></p>

    <% if review.user.present? && review.user == Current.user %>

      <%= link_to "Delete Review",
            [@book, review],
            method: :delete,
            data: { turbo_confirm: "Are you sure?" },
            class: "mt-2 bg-red-600 text-white px-3 py-1 rounded" %>

      <%= link_to "Edit Review",
            edit_book_review_path(@book, review),
            class: "bg-yellow-500 text-white px-3 py-1 rounded mr-2" %>

    <% end %>

  </div>
<% end %>

<h3>Add a Review</h3>

  <% if @review&.errors&.any? %>
  <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded">
    <h2>
      <%= pluralize(@review.errors.count, "error") %>
      prevented this review from being saved:
    </h2>

    <ul class="list-disc ml-6">
      <% @review.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>


<%= form_with(model: [@book, @review || Review.new], local: true) do |form| %>

  <p>Note: Rating increases from left to right</p>
  <%# RATING SECTION %>


  <div class="mb-4">
  <%= form.label :rating, "Rating", class: "block font-semibold mb-2" %>

  <p class="text-sm text-gray-600 mb-2">
    Click a star to rate from 1 to 5.
  </p>

  <div class="flex items-center space-x-5">
    <% (1..5).each do |star| %>
    
      <%= form.radio_button :rating, star,
            id: "review_rating_#{star}",
            style: "display: none;" %>

      <!-- Visible clickable star -->
      
      <%= label_tag "review_rating_#{star}", "★",
            class: "text-4xl cursor-pointer select-none text-yellow-400 hover:scale-110 hover:text-yellow-100 transition" %>
    <% end %>
    
  </div>
    <p class="text-sm text-gray-500 mt-1"> 1 = Poor, 5 = Excellent</p>
</div>
  


  <div class="mb-4">
    <%= form.label :content, "Review" %>
    <%= form.text_area :content, rows: 4, class: "w-full border rounded p-2" %>
  </div>

  <div>
    <%= form.submit "Submit Review",
          class: "bg-blue-600 text-white px-4 py-2 rounded" %>
  </div>

<% end %>

  <div class="mt-6 ">
  
  <%= link_to "Edit this book", edit_book_path(@book), class: "bg-blue-600 text-white px-4 py-2 rounded" %> |
  <%= link_to "Back to books", books_path, class: "bg-blue-600 text-white px-4 py-2 rounded" %>

  <%= button_to "Destroy this book", @book, method: :delete, class: "bg-blue-600 hover:bg-blue-800 text-white px-4 py-2 rounded" %>

  </div>