
<div class="bg-white rounded-2xl shadow-lg overflow-hidden mb-8">

  <div class="grid md:grid-cols-3 gap-8 p-8">

    <div>
      <% if @book.book_image.attached? %>
        <%= image_tag @book.book_image,
          class: "w-full rounded-xl shadow-lg" %>
      <% else %>
        <div class="h-96 bg-[#D8CAB0] rounded-xl flex items-center justify-center">
          <span class="text-gray-600">No Cover Available</span>
        </div>
      <% end %>
    </div>

    <div class="md:col-span-2">

      <h1 class="text-4xl font-bold text-[#11296B] mb-2">
        <%= @book.name %>
      </h1>

      <p class="text-xl text-gray-600 mb-4">
        by <%= @book.author %>
      </p>

      <div class="flex flex-wrap gap-3 mb-4">

        <span class="bg-[#FFD500] text-[#11296B] px-3 py-1 rounded-full font-semibold">
          <%= @book.genre %>
        </span>

        <span class="bg-[#F7F4ED] px-3 py-1 rounded-full">
          <%= @book.language %>
        </span>

      </div>

      <p class="mb-2">
        <strong>Pages:</strong>
        <%= @book.page_count %>
      </p>

      <p class="mb-2">
        <strong>Published:</strong>
        <%= @book.publication_date&.strftime("%B %d, %Y") %>
      </p>

      <% if @book.average_rating.present? %>

  <div class="text-[#FFD500] text-2xl">
    <%= "★" * @book.average_rating.round %>
    <%= "☆" * (5 - @book.average_rating.round) %>
  </div>

  <p class="text-gray-600">
    <%= @book.average_rating.round(1) %>/5
  </p>

<% else %>

  <p class="text-gray-500">No ratings yet.</p>

  <% end %>

    </div>

  </div>

</div>

<div class="bg-white rounded-2xl shadow-lg p-8 mb-8">

  <h2 class="text-2xl font-bold text-[#11296B] mb-4">
    About this Book
  </h2>

  <div class="mb-6">
    <h3 class="font-semibold text-lg">
      Description
    </h3>

    <p class="text-gray-700">
      <%= @book.description %>
    </p>
  </div>

  <div class="mb-6">
    <h3 class="font-semibold text-lg">
      Notes
    </h3>

    <p class="text-gray-700">
      <%= @book.notes %>
    </p>
  </div>

  <% if @book.book_file.attached? %>
    <%= link_to @book.book_file.filename,
          rails_blob_path(@book.book_file, disposition: "attachment"),
          class: "inline-block bg-[#00509D] text-white px-4 py-2 rounded-lg hover:bg-[#11296B]" %>
  <% end %>
  
  <!--FAVORTIE SECTION-->
  <div class="mt-3">
    <% favorite = Current.user&.favorites&.find_by(book: @book) %>

<% if authenticated? %>

  <% if favorite %>

    <%= button_to "♥",
          book_favorite_path(@book, favorite),
          method: :delete,
          class: "w-12 h-12 bg-red-600 text-white rounded-full flex items-center justify-center text-xl hover:bg-red-700 transition" %>

  <% else %>

    <%= button_to "♡",
          book_favorites_path(@book),
          method: :post,
          class: "w-12 h-12 bg-[#FFD500] text-[#11296B] rounded-full flex items-center justify-center text-xl hover:bg-[#FFDB57] transition" %>

  <% end %>

<% end %>
  </div>

</div>

    <!--REVIEWS -->
    <!--User reviews-->
  <div class="bg-[#F7F4ED] rounded-2xl p-2 mb-10">
  <h2 class="text-3xl font-bold text-[#11296B] mb-6">Reader Reviews</h2>

<% @book.reviews.each do |review| %>
  <div class="bg-white rounded-xl shadow-md p-5 mb-4">

    <span>
    <p>
      <strong>Reviewer:</strong>
      <%= review.user&.email_address || "Anonymous User" %>
    </p>
    </span>

    <span>
      <p class= "text-sm text-gray-500">
        <% if review.created_at.present? %>

        Reviewed: <%= time_ago_in_words(review.created_at) %> ago

        <% else %>
          Just now
          <% end %>
      </p>
    </span>

    <!--User Rating-->
    <p>
      <strong>Rating:</strong>

      <span class="text-yellow-400 text-2xl">
        <% rating = review.rating.to_i %>
        <%= "★" * rating %>
        <%= "☆" * (5 - rating) %>
      </span>

      (<%= review.rating %>/5)
    </p>

    <p class="mb-4">
      <%= review.content %></p>

    <% if review.persisted? && review.user.present? && review.user == Current.user %>

          <!--Review delete-->
      <div class="mt-4 flex gap-2">

      <%= button_to "✕ Delete",
            book_review_path(@book, review),
            method: :delete,
            data: { turbo_confirm: "Are you sure?" },
            class: "mt-2 bg-red-600 text-white hover:bg-red-700 px-3 py-2 rounded" %>

          <!--Review edit -->
      <%= link_to "🖉 Edit",
            edit_book_review_path(@book, review),
            class: "mt-2 bg-[#F7F4ED] text-[#11296B] border border-[#11296B] hover:text-[#d8cab0] px-3 py-2 rounded" %>
        
      </div>
    <% end %>
  </div>
  
<% end %>
</div>


<!--Writing review section-->
<div class="bg-white rounded-2xl shadow-lg p-8 mt-10">
<h3 class="text-3xl font-bold text-[#11296B] mb-4">Leave a Review</h3>

<%= form_with(model: [@book, @review || Review.new], local: true) do |form| %>

  <% if @review&.errors&.any? %>
  <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded">
    <h2>
      <%= pluralize(@review.errors.count, "error") %>
      prevented this review from being saved:
    </h2>

    <ul class="list-disc ml-6">
      <% @review.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
  
  

<!--Enter rating section-->

<div class="mb-6">
  <%= form.label :rating, "Rating", class: "block font-semibold mb-3" %>

  <div id="star-rating" class="flex gap-1">
    <% (1..5).each do |star| %>

      <%= form.radio_button :rating, star,
            id: "review_rating_#{star}",
            class: "hidden star-input" %>

      <label
        for="review_rating_<%= star %>"
        data-value="<%= star %>"
        class="star text-4xl cursor-pointer text-gray-300 transition hover:scale-110">
        ★
      </label>

    <% end %>
  </div>

  <p class="text-sm text-gray-500 mt-2">
    1 = Poor, 5 = Excellent
  </p>
</div>

    <!-- Review Content -->
  <div class="mb-6">
    <%= form.label :content, "Review", class: "text-[#00509D] font-serif text-2xl pt-6" %>
    <%= form.text_area :content, rows: 4, class: "w-full border border-[#00509D] rounded-lg focus:ring-2 focus:ring-[#FFD500] p-4" %>
  </div>

  <div>
    <%= form.submit "Submit Review",
          class: "bg-[#11296B] hover:bg-[#FFD500] text-[#FFFFFF] hover:text-[#11296B] px-4 py-2 rounded" %>
  </div>

  <%end %>

  </div>

  <div class="flex gap-4 mt-8 flex-wrap">
  <% if @book.user.present? && @book.user == Current.user %>

  <%= link_to "🖉 Edit", edit_book_path(@book), class: "bg-[#00509D] text-white px-4 py-2 rounded-lg " %> 
  <%= link_to "↩ Back", books_path, class: "bg-[#F7F4ED] px-4 py-2 rounded-lg border border-[#11296B]" %>

  <%= button_to "✕ Destroy", @book, method: :delete, class: "bg-red-600 hover:bg-red-800 text-white px-4 py-2 rounded" %>

  <% end %>
  </div>
