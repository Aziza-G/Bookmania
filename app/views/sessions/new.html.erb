
  <div class="min-h-screen flex flex-row">

      <!--Image side-->

      <div class="hidden md:flex w-1/2 bg-gradient-to-br from-[#11296B] to-[#188de7] items-center justify-center p-10">
      <div class="text-center text-white">
    
    <%= image_tag "reading.svg", class: "w-100 mx-auto mb-6" %>

    <h1 class="text-4xl font-bold mb-4">
      Discover Your Next Favorite Book
    </h1>

    <p class="text-lg text-gray-200">
      Review, rate, and share your reading journey.
    </p>

  </div>

  </div>



  <!--Log in Section -->

  <div class="w-full md:w-1/2 flex items-center justify-center bg-[#F7F4ED]">

  <div class="w-full max-w-md p-8">

    <h2 class="flex items-center gap-3 text-3xl font-bold text-[#11296B] mb-8">
      <%= image_tag "light-bulb.svg", class: "w-10 h-10" %> 
      
      <span> Welcome Back! </span>
    </h2>

    <!-- FORM --> 


  <%= form_with url: session_path, local: true do |form| %>
  <div class="mb-4">
    <%= form.label :email_address %>
    <%= form.email_field :email_address,
          class: "w-full rounded-xl border border-gray-300 bg-white px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#00509D] hover:bg-gray-300" %>
  </div>

  <div class="mb-4">
    <%= form.label :password %>
    <%= form.password_field :password,
          class: "w-full rounded-xl border border-gray-300 bg-white px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#00509D] hover:bg-gray-300" %>
  </div>

  <%= form.submit "Login",
        class: "bg-blue-600 text-white border hover:border-blue-600 hover:bg-white hover:text-blue-600 px-4 py-2 rounded" %>
  <% end %>

</div>