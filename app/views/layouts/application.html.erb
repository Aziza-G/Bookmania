<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Bookmania" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Bookmania">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-[#F7F4ED]">
    <!-- NAVIGATION BAR-->

    <nav class = "bg-gradient-to-r from-[#11296B] to-[#164dde] text-[#EDEDED] shadow-md">
      <div class = "max-w-7xl mx-auto px-6 py-6 flex justify-between items-center">

          <!--Logo-->
          <div class="text-[#FFD500] font-['Merriweather']">
            <%= link_to books_path, class: "flex items-center gap-2 text-2xl font-bold hover:text-[#FFDB57] hover:scale-105 transition" do %>

              <%= image_tag "book-storm.svg", class: "w-12 h-12 hover:scale-105 transition" %>

              <span>Bookmania</span>

            <% end %>
          </div>

      

         
      
          <!--Navigation-->
      <div class="flex items-center gap-4">

         <% if authenticated? %>

        <%= link_to "Add Books", new_book_path, class: "px-6 py-2 bg-gray-900 hover:bg-gray-500 rounded font-serif hover:text-gray-200" %>

       <span class="text-sm text-gray-700 px-3 py-2 bg-[#d8cab0] rounded-lg">
          Signed in as <strong><%= Current.user.email_address %></strong>
        </span>

        <%= button_to "Logout", session_path,
        method: :delete,
        class: "bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded" %>

        <% elsif controller_name == "sessions" %>

        <%= link_to "Sign Up", sign_up_path,
        class: "border border-white px-4 py-2 rounded hover:bg-white hover:text-[#11296B] transition" %>

        <% elsif controller_name == "users" %>

         <%= link_to "Log In", new_session_path,
        class: "border border-white px-4 py-2 rounded hover:bg-white hover:text-[#11296B] transition" %>

      <% end %>

        </div>

      </div>
    </nav>

    <main>
      <%= yield %>
    </main>

  </body>
</html>
