<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Bookmania" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Bookmania">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
    
    <script>
      document.addEventListener("turbo:load", () => {
        const flash = document.getElementById("flash-message"); 
        if (flash) {
          setTimeout(() => {
            flash.classList.add("opacity-0", "translate-y-[20px]"); 
          }, 3000);

          setTimeout(() => {
            flash.remove(); 
          }, 3500); 
        }
      }); 

    </script>

    
  <body class="bg-[#F7F4ED]">
    <!-- NAVIGATION BAR-->

    <nav class = "bg-gradient-to-r from-[#11296B] to-[#164dde] text-[#EDEDED] shadow-md border-b-4 border-[#FFD500]">
      <div class = "max-w-7xl mx-auto px-8 py-5 flex justify-between items-center">

          <!--LEFT-->
          <div class="flex items-center gap-15">

          <!--Logo-->
          <div class="text-[#FFD500] font-['Merriweather']">
            <%= link_to books_path, class: "flex items-center gap-3 text-4xl font-bold tracking-wide hover:text-[#FFDB57] hover:scale-105 transition" do %>

              <%= image_tag "book-storm.svg", class: "w-12 h-12 hover:scale-105 transition" %>

              <span>Bookmania</span>

            <% end %>
          </div>
         
      
          <!--Navigation left-->
      <div class="mt-2 flex gap-6">

         <% if authenticated? %>

        <%= link_to "My Books", books_path, class: "text-md font-medium hover:text-[#FFD500]"%>
        <%= link_to "Add Books", new_book_path, class: "text-md font-medium hover:text-[#FFD500]" %>

        <%= link_to "🎔 Favourites", favorites_path, class: "text-md font-medium hover:text-[#FFD500]" %>

        <% elsif controller_name == "sessions" %>

        <%= link_to "Sign Up", sign_up_path,
        class: "border border-white px-3 py-1 rounded hover:bg-white hover:text-[#11296B] transition" %>

        <% elsif controller_name == "users" %>

         <%= link_to "Log In", new_session_path,
        class: "border border-white px-4 py-2 rounded hover:bg-white hover:text-[#11296B] transition" %>

      <% end %>

        </div>

      </div>

      <div class = "flex items-center gap-4">
      <% if Current.user %>
  <span class="bg-white text-[#11296B] px-4 py-1 rounded-full text-sm font-medium">
    <%= Current.user&.email_address %>
  </span>

  <%= button_to "Logout", session_path,
      method: :delete,
      class: "bg-red-500 hover:bg-red-700 px-4 py-2 rounded-lg" %>
    <% end %>
        </div>

    </nav>

    <script>
document.addEventListener("turbo:load", () => {
  const stars = document.querySelectorAll(".star");
  const inputs = document.querySelectorAll(".star-input");

  function updateStars(value) {
    stars.forEach((star) => {
      const starValue = parseInt(star.dataset.value);

      if (starValue <= value) {
        star.classList.remove("text-gray-300");
        star.classList.add("text-yellow-400");
      } else {
        star.classList.remove("text-yellow-400");
        star.classList.add("text-gray-300");
      }
    });
  }

  inputs.forEach((input) => {
    input.addEventListener("change", () => {
      updateStars(parseInt(input.value));
    });
  });

  const checkedInput = document.querySelector(".star-input:checked");

  if (checkedInput) {
    updateStars(parseInt(checkedInput.value));
  }
});
</script>

    <main class="<%= controller_name == 'sessions' || controller_name == 'users' ? 'px-0 py-0' : 'max-w-7xl mx-auto px-6 py-8' %>">
      <% if notice %>
        <div id="flash-message" class="fixed top-6 right-6 z-50 bg-green-500 text-white px-6 py-3 rounded-xl shadow-lg transistion-all duration-500">
          <%= notice %>
          </div>
          <% end %>
      
    <% if alert %>
      <div id="flash-message" class="fixed top-6 right-6 z-50 bg-red-600 text-white px-6 py-3 rounded-xl shadow-lg transition-all duration-500">
        <%= alert %>
        </div>
        <% end %>

      <%= yield %>
    </main>

  </body>
</html>
